# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*
*.tfstate.backup
*.tfstate.lock.info

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json
secrets.auto.tfvars

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you do want to add
!example_override.tf

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Sensitive files
*.pem
*.priv
*.key
*.secret

# Temporary files
*.tmp
*.bak
*.swp
*.swo
*~
.DS_Store

# IDE files
.vscode/
.idea/
*.sublime-*
